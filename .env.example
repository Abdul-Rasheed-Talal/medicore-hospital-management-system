# MediCore environment template — PLACEHOLDERS ONLY.
# Copy to .env and fill in real values. Never commit .env or real secrets.
# See README.md and docs/adr/001-stack.md. All values below are examples.

# Django settings module: medicore.settings.dev (local) or
# medicore.settings.prod (hosted/demo). manage.py defaults to dev.
DJANGO_SETTINGS_MODULE=medicore.settings.dev

# Django secret key — generate a fresh random value per environment.
# Example generation: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Production settings refuse to start with the dev placeholder.
SECRET_KEY=

# PostgreSQL connection (Django DATABASE_URL style)
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Local dev without Postgres: leave DATABASE_URL unset and the backend
# falls back to SQLite (backend/db.sqlite3). For Postgres, start it
# with `docker compose up -d db` and use the value below (password
# CHANGE_ME must match docker-compose.yml or your own Postgres).
DATABASE_URL=postgres://medicore:CHANGE_ME@localhost:5432/medicore

# Debug mode — NEVER true in a hosted/demo environment.
DEBUG=False

# Allowed hosts, comma-separated (e.g. localhost,127.0.0.1)
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origin for CORS / CSRF (development default).
# The Vite dev server proxies /api to Django, so the frontend and API
# share one origin in development.
FRONTEND_ORIGIN=http://localhost:5173

# Trusted origins for CSRF (comma-separated). Must include the frontend
# origin when it is served from a different host/port than the API.
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Display timezone for the hospital (scheduling and reports).
# Decided (ADR-001): Asia/Karachi. Timestamps are stored in UTC.
TIME_ZONE=Asia/Karachi
