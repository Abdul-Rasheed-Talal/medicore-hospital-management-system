# =============================================================================
# MediCore - Hospital Management System
# Root .gitignore
#
# Scope notes:
#   - .specify/.gitignore is maintained separately and is not duplicated here.
#   - .agents/ and .specify/ are intentionally NOT ignored as directories.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Environment files and secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# -----------------------------------------------------------------------------
# 2. Python artifacts
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# -----------------------------------------------------------------------------
# 3. Node / frontend artifacts
# -----------------------------------------------------------------------------
node_modules/
dist/
build/

# Coverage output
coverage/
.coverage
coverage.xml
htmlcov/
*.lcov

# Package-manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# 4. Local databases and backups
# -----------------------------------------------------------------------------
*.sqlite
*.sqlite3
db.sqlite3
*.db
*.dump
*.bak
backups/

# -----------------------------------------------------------------------------
# 5. Operating-system clutter
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# 6. Local IDE state (shared project configuration preserved below)
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.idea/*
!.idea/runConfigurations/

# Editor swap and backup files
*.swp
*.swo
*~
